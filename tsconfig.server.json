{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "./dist",
    "rootDir": ".",
    "target": "es2020",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["server.ts", "src/game/**/*.ts"],
  "exclude": ["node_modules", "src/app", "src/components", "src/hooks"]
}
